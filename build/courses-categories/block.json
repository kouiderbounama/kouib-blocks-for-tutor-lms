{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kouib/courses-categories",
  "version": "1.0.0",
  "title": "Tutor Courses Categories",
  "description": "Course category boxes for Tutor LMS with a custom icon per category (upload PNG images and replace or remove them)",
  "category": "kouib-blocks",
  "icon": "category",
  "keywords": [
    "tutor",
    "lms",
    "categories",
    "courses",
    "boxes",
    "icons"
  ],
  "textdomain": "kouib-blocks-for-tutor-lms",
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 2
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "icons": {
      "type": "array",
      "default": []
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "hideEmpty": {
      "type": "boolean",
      "default": true
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "primaryColor": {
      "type": "string",
      "default": "#2a7be4"
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "kouib-categories-style",
  "style": "kouib-categories-style"
}