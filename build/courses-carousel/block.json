{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kouib/courses-carousel",
  "version": "1.0.0",
  "title": "Tutor Courses Carousel",
  "description": "Interactive carousel for displaying Tutor LMS courses with full motion and navigation control",
  "category": "kouib-blocks",
  "icon": "slides",
  "keywords": [
    "tutor",
    "lms",
    "courses",
    "carousel",
    "slider"
  ],
  "textdomain": "kouib-blocks-for-tutor-lms",
  "attributes": {
    "hasShadow": {
      "type": "boolean",
      "default": true
    },
    "coursesToShow": {
      "type": "number",
      "default": 3
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "columnsTablet": {
      "type": "number",
      "default": 2
    },
    "columnsMobile": {
      "type": "number",
      "default": 1
    },
    "orderby": {
      "type": "string",
      "default": "date"
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "autoplaySpeed": {
      "type": "number",
      "default": 3000
    },
    "speed": {
      "type": "number",
      "default": 500
    },
    "infiniteLoop": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": true
    },
    "showDots": {
      "type": "boolean",
      "default": true
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "showLevel": {
      "type": "boolean",
      "default": true
    },
    "showRating": {
      "type": "boolean",
      "default": true
    },
    "showLessons": {
      "type": "boolean",
      "default": true
    },
    "showDuration": {
      "type": "boolean",
      "default": true
    },
    "showPrice": {
      "type": "boolean",
      "default": true
    },
    "showStudents": {
      "type": "boolean",
      "default": true
    },
    "showEnrollBtn": {
      "type": "boolean",
      "default": true
    },
    "enrollBtnText": {
      "type": "string",
      "default": "Enroll in course"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "primaryColor": {
      "type": "string",
      "default": "#2a7be4"
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "kouib-carousel-style",
  "style": "kouib-carousel-style",
  "viewScript": "kouib-carousel-view"
}